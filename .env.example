# Defaults match docker-compose.yml; copy to .env only to override.
FORGEQUOR_DATABASE_URL=postgres://forgequor:forgequor@localhost:5433/forgequor
FORGEQUOR_PORT=4170

# Opt-in smoke test: a throwaway GitHub repository you own, with a "main" branch,
# where `npm run smoke:gh` opens, comments on and closes a real pull request.
# FORGEQUOR_SMOKE_REPO=owner/name

# How often (seconds) Approved Runs check whether their pull request was merged or closed,
# and Paused Runs check whether their Quota reset time has passed.
# FORGEQUOR_PR_POLL_SECONDS=60

# How many days an archived Run is kept before it is deleted with everything that belongs to it.
# FORGEQUOR_ARCHIVE_DAYS=60

# Which Runner (claude or codex) and which model each Agent seat works through. Seats: GRILLER, SPEC_WRITER,
# ARCHITECT, DEVELOPER, REVIEWER_A, REVIEWER_B, CONSOLIDATOR, ARTIST. Claude Code is the default, except for
# REVIEWER_B and ARTIST (Codex).
# FORGEQUOR_DEVELOPER_RUNNER=claude
# FORGEQUOR_DEVELOPER_MODEL=
# FORGEQUOR_REVIEWER_A_RUNNER=claude
# FORGEQUOR_ARTIST_MODEL=

# How long (minutes) a Developer Step may run before it is killed and escalated.
# FORGEQUOR_STEP_TIMEOUT_MINUTES=60

# How long (minutes) one Check command may run before it is killed and counts as failed.
# FORGEQUOR_CHECK_TIMEOUT_MINUTES=10

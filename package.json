{
  "name": "forgequor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build:web": "vite build web",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "smoke:gh": "FORGEQUOR_SMOKE_GH=1 vitest run tests/codehost/gh.smoke.test.ts",
    "smoke:codex": "FORGEQUOR_SMOKE_CODEX=1 vitest run tests/runner/codex.smoke.test.ts",
    "smoke:claude": "FORGEQUOR_SMOKE_CLAUDE=1 vitest run tests/runner/claude.smoke.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
